<Window x:Class="warehouse.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:warehouse"
        mc:Ignorable="d"
        Title="Warehouse Management - Login" 
        Height="400" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1" 
                   Text="Warehouse Management System" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,30"/>

        <StackPanel Grid.Row="2" Margin="50,10">
            <TextBlock Text="Username:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox FontSize="16" 
                     Height="35"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="50,10">
            <TextBlock Text="Password:" FontSize="16" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" 
                         FontSize="16" 
                         Height="35"
                         PasswordChanged="PasswordBox_PasswordChanged"/>
        </StackPanel>

        <Button Grid.Row="4" 
                Content="Login" 
                Width="200" 
                Height="45" 
                FontSize="18" 
                Margin="0,20,0,0"
                Command="{Binding LoginCommand}"/>
    </Grid>
</Window>