<UserControl x:Class="warehouse.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:warehouse.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <DockPanel>
        <ToolBar DockPanel.Dock="Top" BorderBrush="Transparent" Background="Transparent" FontSize="18">
            <Separator Width="Auto"/>
            <Button Content="Add Item" Height="45" Width="150" FontSize="18"
                    Command="{Binding DataContext.SetAddItemViewModel, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Separator Width="Auto"/>
            <Button Content="Delete" Height="45" Width="150" FontSize="18"
                    Command="{Binding DeleteItemCommand}"/>
        </ToolBar>

        <DataGrid AutoGenerateColumns="False"
                  BorderBrush="Transparent"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  FontSize="18"
                  RowHeight="40"
                  ColumnHeaderHeight="40"
                  HorizontalGridLinesBrush="LightGray"
                  VerticalGridLinesBrush="LightGray"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Header="Item Name" Binding="{Binding Name}" />
                <DataGridTextColumn Width="*" Header="Category" Binding="{Binding CategoryName}" />
                <DataGridTextColumn Width="*" Header="Volume" Binding="{Binding Volume}" />
                <DataGridTextColumn Width="*" Header="Unit" Binding="{Binding Unit}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
