<Window x:Class="warehouse.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:warehouse"
        mc:Ignorable="d"
        Title="DashboardWindow" Height="780" Width="1260">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="Gray" BorderThickness="0,0,1,0" MinWidth="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Button Command="{Binding SetHomeViewModel}" 
                    Content="Home" 
                    Margin="10"
                    FontSize="23"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" 
                    BorderThickness="0"/>

                    <Button Command="{Binding SetCategoriesViewModel}" 
                    Content="Categories" 
                    Margin="10"
                    FontSize="23"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" 
                    BorderThickness="0"/>

                    <Button Command="{Binding SetInventoryViewModel}" 
                    Content="Inventory" 
                    Margin="10"
                    FontSize="23"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" 
                    BorderThickness="0"/>

                    <Button Command="{Binding SetShelvesViewModel}" 
                    Content="Shelves"
                    Margin="10" 
                    FontSize="23"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" 
                    BorderThickness="0"/>

                    <Button Command="{Binding SetTransfersViewModel}" 
                    Content="Transfers"
                    Margin="10"
                    FontSize="23"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" 
                    BorderThickness="0"/>

                    <Button Command="{Binding SetUserManagementViewModel}" 
                    Content="User Management"
                    Margin="10"
                    FontSize="23"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" 
                    BorderThickness="0"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Rectangle Height="320"/>

                    <TextBlock Text="{Binding SessionTime}" 
                             FontSize="18" 
                             Margin="10,15,10,5"
                             HorizontalAlignment="Left"
                             FontWeight="Bold"/>

                    <TextBlock Text="{Binding CurrentUsername}" 
                    Margin="10" 
                    FontSize="23"
                    HorizontalAlignment="Left"/>

                    <!--<Button Content="Logout" 
                    Margin="10" 
                    FontSize="23"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" 
                    BorderThickness="0"/>-->
                </StackPanel>
            </ScrollViewer>
        </Border>


        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="0,0,0,1" Background="Transparent" >
                <TextBlock FontSize="40" Text="{Binding HeaderTitle}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
