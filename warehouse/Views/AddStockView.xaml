<UserControl x:Class="warehouse.Views.AddStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Margin="0,10">
            <TextBlock Text="Shelf:" FontSize="16" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding SelectedShelf.Name}" 
               FontSize="24" 
               FontWeight="Bold"
               Height="35"
               VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10">
            <TextBlock Text="Item:" FontSize="16" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding AvailableItems}"
                      SelectedItem="{Binding SelectedItem}"
                      DisplayMemberPath="Name"
                      FontSize="16"
                      Height="35"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,10">
            <TextBlock Text="Quantity:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16"
                     Height="35"/>
        </StackPanel>

        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0">
            
            <Button Content="Add Stock"
                    Width="120"
                    Height="40"
                    FontSize="16"
                    Margin="0,0,10,0"
                    Command="{Binding AddStockCommand}"/>
            
            <Button Content="Clear Form" 
                    Width="120" 
                    Height="40" 
                    Margin="0,0,10,0" 
                    FontSize="16"
                    Command="{Binding ClearFormCommand}" />
            
            <Button Content="Cancel"
                    Width="120"
                    Height="40"
                    FontSize="16"
                    Command="{Binding DataContext.SetShelvesViewModel,
                                      RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</UserControl>