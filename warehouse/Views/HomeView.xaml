<UserControl x:Class="warehouse.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:warehouse.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Dashboard Statistics" 
                   FontSize="32" 
                   FontWeight="Bold" 
                   Margin="30"
                   HorizontalAlignment="Center"/>

        <Grid Grid.Row="1" Margin="50">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" 
                    BorderBrush="Gray" 
                    BorderThickness="2" 
                    Margin="15">
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Margin="30">
                    <TextBlock Text="Total Items" 
                               FontSize="24" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalItems}" 
                               FontSize="48" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" 
                    BorderBrush="Gray" 
                    BorderThickness="2" 
                    Margin="15">
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Margin="30">
                    <TextBlock Text="Total Shelves" 
                               FontSize="24" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalShelves}" 
                               FontSize="48" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" 
                    BorderBrush="Gray" 
                    BorderThickness="2" 
                    Margin="15">
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Margin="30">
                    <TextBlock Text="Total Categories" 
                               FontSize="24" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalCategories}" 
                               FontSize="48" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" 
                    BorderBrush="Gray" 
                    BorderThickness="2" 
                    Margin="15">
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Margin="30">
                    <TextBlock Text="Total Stock Quantity" 
                               FontSize="24" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalStock}" 
                               FontSize="48" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>