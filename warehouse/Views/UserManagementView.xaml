<UserControl x:Class="warehouse.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:warehouse.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" 
                  AutoGenerateColumns="False"
                  BorderBrush="Transparent"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  FontSize="16"
                  RowHeight="35"
                  ColumnHeaderHeight="35"
                  HorizontalGridLinesBrush="LightGray"
                  VerticalGridLinesBrush="LightGray"
                  IsReadOnly="True"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Header="Username" Binding="{Binding Username}" />
                <DataGridTextColumn Width="*" Header="Role" Binding="{Binding Role}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Add New User" FontSize="18" Padding="10" Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Username:" FontSize="14" Margin="0,5"/>
                    <TextBox FontSize="14" Height="30" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Password:" FontSize="14" Margin="0,10,0,5"/>
                    <TextBox FontSize="14" Height="30" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Role:" FontSize="14" Margin="0,10,0,5"/>
                    <ComboBox FontSize="14" 
                              Height="30" 
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding NewRole}"/>

                    <Button Content="Add User" 
                            Width="120" 
                            Height="35" 
                            Margin="0,15,0,0" 
                            FontSize="14"
                            Command="{Binding AddUserCommand}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Edit Selected User" FontSize="18" Padding="10" Grid.Row="1" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Username:" FontSize="14" Margin="0,5"/>
                    <TextBox FontSize="14" Height="30" Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Password:" FontSize="14" Margin="0,10,0,5"/>
                    <TextBox FontSize="14" Height="30" Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Role:" FontSize="14" Margin="0,10,0,5"/>
                    <ComboBox FontSize="14" 
                              Height="30" 
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding EditRole}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Update User" 
                                Width="120" 
                                Height="35" 
                                Margin="5,0" 
                                FontSize="14"
                                Command="{Binding UpdateUserCommand}"/>
                        <Button Content="Delete User" 
                                Width="120" 
                                Height="35" 
                                Margin="5,0" 
                                FontSize="14"
                                Command="{Binding DeleteUserCommand}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>