<UserControl x:Class="warehouse.Views.ShelvesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:warehouse.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>

        <ToolBar DockPanel.Dock="Top" BorderBrush="Transparent" Background="Transparent" FontSize="18">
            <Separator Width="Auto"/>
            <Button Content="Add Shelf" Height="45" Width="150" FontSize="18"
                    Command="{Binding DataContext.SetAddShelfViewModel, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Separator Width="Auto"/>
            <Button Content="Delete" Height="45" Width="150" FontSize="18"
                    Command="{Binding DeleteShelfCommand}"/>
        </ToolBar>

        <DataGrid AutoGenerateColumns="False"
                  BorderBrush="Transparent"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Shelves}"
                  SelectedItem="{Binding SelectedShelf}"
                  FontSize="18"
                  RowHeight="40"
                  ColumnHeaderHeight="40"
                  HorizontalGridLinesBrush="LightGray"
                  VerticalGridLinesBrush="LightGray"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Header="Shelf Name" Binding="{Binding Name}" />

                <DataGridTemplateColumn Width="150" Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Details"
                                    Height="35"
                                    Width="120"
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Command="{Binding DataContext.SetStockViewModel, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>
</UserControl>
